<ContentDialog x:ConnectionId='1'
    x:Class="AIAgentGUI.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="⚙ 设置"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
                                  >

    <StackPanel Spacing="14" MinWidth="400">

        <StackPanel Spacing="6">
            <TextBlock Text="模型名称" FontSize="13" Foreground="#8B98A5"/>
            <ComboBox x:ConnectionId='15' x:Name="ModelBox" IsEditable="True"
                      PlaceholderText="选择或输入模型名"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="API 地址" FontSize="13" Foreground="#8B98A5"/>
            <TextBox x:ConnectionId='14' x:Name="BaseUrlBox" PlaceholderText="https://api.deepseek.com"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="API 密钥" FontSize="13" Foreground="#8B98A5"/>
            <PasswordBox x:ConnectionId='13' x:Name="ApiKeyBox"
                         PlaceholderText="留空则使用系统环境变量 OPENAI_API_KEY"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="后端端口" FontSize="13" Foreground="#8B98A5"/>
            <NumberBox x:ConnectionId='12' x:Name="PortBox" Minimum="1024" Maximum="65535"
                       SpinButtonPlacementMode="Inline"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="消息字号" FontSize="13" Foreground="#8B98A5"/>
            <NumberBox x:ConnectionId='11' x:Name="FontBox" Minimum="10" Maximum="26"
                       SpinButtonPlacementMode="Inline"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="主题色" FontSize="13" Foreground="#8B98A5"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:ConnectionId='6' x:Name="AccentBox" Width="110" Text="#4D9FFF"/>
                <Button x:ConnectionId='7' Tag="A#4D9FFF" Content="蓝"                          
                        Background="#161D26" Foreground="#E6EDF3" BorderBrush="#232C37"/>
                <Button x:ConnectionId='8' Tag="A#3FB950" Content="绿"                          
                        Background="#161D26" Foreground="#E6EDF3" BorderBrush="#232C37"/>
                <Button x:ConnectionId='9' Tag="A#A371F7" Content="紫"                          
                        Background="#161D26" Foreground="#E6EDF3" BorderBrush="#232C37"/>
                <Button x:ConnectionId='10' Tag="A#F0883E" Content="橙"                          
                        Background="#161D26" Foreground="#E6EDF3" BorderBrush="#232C37"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="背景色 (默认白色)" FontSize="13" Foreground="#8B98A5"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:ConnectionId='2' x:Name="BgBox" Width="110" Text="#FFFFFF"/>
                <Button x:ConnectionId='3' Tag="B#FFFFFF" Content="白"                          
                        Background="#161D26" Foreground="#E6EDF3" BorderBrush="#232C37"/>
                <Button x:ConnectionId='4' Tag="B#0B0F14" Content="深"                          
                        Background="#161D26" Foreground="#E6EDF3" BorderBrush="#232C37"/>
                <Button x:ConnectionId='5' Tag="B#F0F2F5" Content="浅灰"                          
                        Background="#161D26" Foreground="#E6EDF3" BorderBrush="#232C37"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="设置保存在项目根目录 settings.json，网页版与桌面版通用；后端配置（模型/地址/密钥/端口）保存后自动重启后端生效。"
                   FontSize="11" Foreground="#8B98A5" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>


<Window
    x:Class="AIAgentGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI Agent">

    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="#0C1117" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 侧边栏 ============ -->
        <Grid x:ConnectionId='3' Grid.Column="0" x:Name="SidebarPanel" Background="#10151C"
              BorderBrush="#1E2833" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 应用标识 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,16,16,14">
                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentGradientBrush}">
                    <TextBlock Text="AI" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="AI Agent" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                    <TextBlock Text="本地智能体工作台" FontSize="10.5" Foreground="#6E7B8A"/>
                </StackPanel>
            </StackPanel>

            <!-- 新建对话 -->
            <Button x:ConnectionId='16' Grid.Row="1" x:Name="NewChatBtn" Style="{StaticResource AccentButtonStyle}"
                    Margin="12,0,12,12"                      >
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="12" FontFamily="Segoe Fluent Icons" Foreground="White"/>
                    <TextBlock Text="新建对话" FontSize="13" Foreground="White"/>
                </StackPanel>
            </Button>

            <!-- 会话列表 -->
            <ListView x:ConnectionId='17' Grid.Row="2" x:Name="SessionList" Background="Transparent"
                      BorderThickness="0"                                                
                      ItemContainerStyle="{StaticResource SessionItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                   FontSize="13" Foreground="#C9D4DE"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 底部状态卡 -->
            <Grid Grid.Row="3" Margin="12,10,12,14">
                <Border x:ConnectionId='18' x:Name="SidebarFooterCard" Background="#151C25" CornerRadius="10" Padding="12,10">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:ConnectionId='20' x:Name="FooterDot" Width="7" Height="7" Fill="#3FB950" VerticalAlignment="Center"/>
                            <TextBlock x:ConnectionId='21' x:Name="FooterStatus" Text="后端在线" FontSize="11" Foreground="#8B98A5"/>
                        </StackPanel>
                        <TextBlock x:ConnectionId='19' x:Name="SidebarFooter" Text="模型: deepseek-v4-flash&#x0a;工具: 15 个系统级 MCP"
                                   FontSize="10.5" Foreground="#6E7B8A" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 主区域 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 (兼作自定义标题栏拖拽区) -->
            <Grid x:ConnectionId='4' Grid.Row="0" x:Name="HeaderPanel" Background="#10151C" BorderBrush="#1E2833" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="AI Agent 工作台" FontWeight="SemiBold" FontSize="13.5" Foreground="#DCE3EA"/>
                    <Border x:ConnectionId='12' x:Name="ModelBadgeBorder" Background="#14243A" CornerRadius="10" Padding="9,2.5">
                        <TextBlock x:ConnectionId='15' x:Name="ModelBadge" Text="deepseek-v4-flash" FontSize="10.5" Foreground="#4D9FFF"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:ConnectionId='13' x:Name="StatusDot" Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center"/>
                        <TextBlock x:ConnectionId='14' x:Name="StatusText" Text="启动中…" FontSize="11.5" Foreground="#8B98A5"/>
                    </StackPanel>
                </StackPanel>
                <Button x:ConnectionId='11' Grid.Column="1" x:Name="SettingsBtn" Style="{StaticResource GhostButtonStyle}"
                                               VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="13" FontFamily="Segoe Fluent Icons" Foreground="#8B98A5"/>
                        <TextBlock Text="设置" FontSize="12.5" Foreground="#C9D4DE"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 消息区 -->
            <ScrollViewer x:ConnectionId='5' Grid.Row="1" x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                          Padding="28,20" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:ConnectionId='10' x:Name="MessagePanel" Spacing="16" HorizontalAlignment="Center" MaxWidth="860"/>
            </ScrollViewer>

            <!-- 输入区 -->
            <Grid x:ConnectionId='6' Grid.Row="2" x:Name="InputPanel" Background="#10151C" BorderBrush="#1E2833" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="28,14,28,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:ConnectionId='7' Grid.Column="0" x:Name="InputShell" Background="#161D26" BorderBrush="#27323F"
                            BorderThickness="1" CornerRadius="12" Padding="14,7">
                        <TextBox x:ConnectionId='9' x:Name="InputBox" PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行…"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="132"
                                 Background="Transparent" BorderThickness="0" Foreground="#E6EDF3"
                                                                                              
                                                                                            />
                    </Border>
                    <Button x:ConnectionId='8' Grid.Column="1" x:Name="SendBtn" Style="{StaticResource AccentButtonStyle}"
                            Width="44" Height="44" CornerRadius="22" Margin="12,0,0,0"
                            VerticalAlignment="Bottom" IsEnabled="False"                   >
                        <FontIcon Glyph="&#xE724;" FontSize="15" FontFamily="Segoe Fluent Icons" Foreground="White"/>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" Text="Agent 可执行 Python / Shell 命令、读写文件、查系统信息、控制进程，高危操作需你确认"
                           FontSize="10.5" Foreground="#6E7B8A" Margin="30,0,0,12"/>
            </Grid>
        </Grid>
    </Grid>
</Window>


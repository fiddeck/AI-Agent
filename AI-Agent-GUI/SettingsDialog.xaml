<ContentDialog
    x:Class="AIAgentGUI.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="⚙ 设置"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimary">

    <StackPanel Spacing="14" MinWidth="400">

        <StackPanel Spacing="6">
            <TextBlock Text="模型名称" FontSize="13" Opacity="0.7"/>
            <ComboBox x:Name="ModelBox" IsEditable="True"
                      PlaceholderText="选择或输入模型名"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="API 地址" FontSize="13" Opacity="0.7"/>
            <TextBox x:Name="BaseUrlBox" PlaceholderText="https://api.deepseek.com"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="API 密钥" FontSize="13" Opacity="0.7"/>
            <PasswordBox x:Name="ApiKeyBox"
                         PlaceholderText="留空则使用系统环境变量 OPENAI_API_KEY"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="后端端口" FontSize="13" Opacity="0.7"/>
            <NumberBox x:Name="PortBox" Minimum="1024" Maximum="65535"
                       SpinButtonPlacementMode="Inline"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="消息字号" FontSize="13" Opacity="0.7"/>
            <NumberBox x:Name="FontBox" Minimum="10" Maximum="26"
                       SpinButtonPlacementMode="Inline"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="主题色" FontSize="13" Opacity="0.7"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="AccentBox" Width="110" Text="#4D9FFF"/>
                <Button Tag="A#4D9FFF" Content="蓝" Click="ColorPreset_Click"/>
                <Button Tag="A#3FB950" Content="绿" Click="ColorPreset_Click"/>
                <Button Tag="A#A371F7" Content="紫" Click="ColorPreset_Click"/>
                <Button Tag="A#F0883E" Content="橙" Click="ColorPreset_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="背景色（默认深色）" FontSize="13" Opacity="0.7"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="BgBox" Width="110" Text="#0C1117"/>
                <Button Tag="B#FFFFFF" Content="白" Click="ColorPreset_Click"/>
                <Button Tag="B#0C1117" Content="深" Click="ColorPreset_Click"/>
                <Button Tag="B#F0F2F5" Content="浅灰" Click="ColorPreset_Click"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="设置保存在项目根目录 settings.json（键名 camelCase），网页版与桌面版共用同一份配置；模型/地址/密钥/端口保存后自动重启后端生效，主题色与字号即时生效。"
                   FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>

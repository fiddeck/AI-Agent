<Window
    x:Class="AIAgentGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI Agent">

    <Grid x:Name="RootGrid" Background="#0C1117" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 (SetTitleBar 拖拽区, 最右侧 150px 留给系统按钮) ============ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#10151C"
              BorderBrush="#1E2833" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="LogoBadge" Width="26" Height="26" CornerRadius="8" Margin="14,0,10,0"
                    Background="{StaticResource AccentGradientBrush}">
                <TextBlock Text="AI" FontSize="10.5" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1" x:Name="AppTitleText" Text="AI Agent" FontSize="13" FontWeight="SemiBold"
                       Foreground="#DCE3EA" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                <Border x:Name="ModelBadgeBorder" Background="#14243A" CornerRadius="10" Padding="9,2.5">
                    <TextBlock x:Name="ModelBadge" Text="deepseek-v4-flash" FontSize="10.5" Foreground="#4D9FFF"/>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="启动中…" FontSize="11.5" Foreground="#8B98A5"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="4" x:Name="SettingsBtn" Style="{StaticResource GhostButtonStyle}"
                    Click="Settings_Click" VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE713;" FontSize="13"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    <TextBlock Text="设置" FontSize="12.5"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Grid Grid.Column="0" x:Name="SidebarPanel" Background="#10151C"
                  BorderBrush="#1E2833" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 新建对话 -->
                <Button Grid.Row="0" x:Name="NewChatBtn" Style="{StaticResource AccentButtonStyle}"
                        Margin="12,14,12,12" Click="NewChat_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="12"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="White"/>
                        <TextBlock Text="新建对话" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- 会话列表 -->
                <ListView Grid.Row="1" x:Name="SessionList" Background="Transparent"
                          BorderThickness="0" SelectionChanged="SessionList_SelectionChanged"
                          ItemContainerStyle="{StaticResource SessionItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                       FontSize="13"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 底部状态卡 -->
                <Grid Grid.Row="2" Margin="12,10,12,14">
                    <Border x:Name="SidebarFooterCard" Background="#151C25" CornerRadius="10" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="FooterDot" Width="7" Height="7" Fill="#3FB950" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FooterStatus" Text="后端在线" FontSize="11" Foreground="#8B98A5"/>
                            </StackPanel>
                            <TextBlock x:Name="SidebarFooter" Text="模型: deepseek-v4-flash&#x0a;工具: 15 个系统级 MCP"
                                       FontSize="10.5" Foreground="#6E7B8A" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 主区域 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 消息区 -->
                <ScrollViewer Grid.Row="0" x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                              Padding="28,20" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MessagePanel" Spacing="16" HorizontalAlignment="Center" MaxWidth="860"/>
                </ScrollViewer>

                <!-- 输入区 -->
                <Grid Grid.Row="1" x:Name="InputPanel" Background="#10151C" BorderBrush="#1E2833" BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="28,14,28,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="InputShell" Background="#161D26" BorderBrush="#27323F"
                                BorderThickness="1" CornerRadius="12" Padding="14,7">
                            <TextBox x:Name="InputBox" PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行…"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="132"
                                     Background="Transparent" BorderThickness="0" Foreground="#E6EDF3"
                                     KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"
                                     GotFocus="InputBox_GotFocus" LostFocus="InputBox_LostFocus"/>
                        </Border>
                        <Button Grid.Column="1" x:Name="SendBtn" Style="{StaticResource AccentButtonStyle}"
                                Width="44" Height="44" CornerRadius="22" Margin="12,0,0,0"
                                VerticalAlignment="Bottom" IsEnabled="False" Click="Send_Click">
                            <FontIcon Glyph="&#xE724;" FontSize="15"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="White"/>
                        </Button>
                        <Button Grid.Column="1" x:Name="StopBtn" Style="{StaticResource AccentButtonStyle}"
                                Background="#F85149" Width="44" Height="44" CornerRadius="22"
                                Margin="12,0,0,0" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Click="Stop_Click" ToolTipService.ToolTip="停止生成">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="White"/>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="InputHint"
                               Text="Agent 可执行 Python / Shell 命令、读写文件、查系统信息、控制进程；生成中可点 ■ 停止，高危操作需你确认"
                               FontSize="10.5" Foreground="#6E7B8A" Margin="30,0,0,12"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
